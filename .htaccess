# Apache 2.4: copy as .htaccess into the web root alongside index.html.
# Upload ONLY dist contents. Requires AllowOverride for these directives.
# Configure HTTPS and canonical-host redirects in your hosting panel.

DirectoryIndex index.html index.php
Options -Indexes
<FilesMatch "^(?:\\.|config\\.php$|lib\\.php$)">
  Require all denied
</FilesMatch>
ErrorDocument 404 /404.html

<IfModule mod_mime.c>
  AddType text/javascript .js .mjs
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# No SPA fallback: nonexistent URLs must return HTTP 404.
# If your host disallows Options/Headers overrides, ask its support to
# apply the equivalent settings. Check the error log if you get HTTP 500.
